{
  "name": "mazzy",
  "version": "1.0.0",
  "private": true,
  "description": "Mazzy two-deck DJ app",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:enhanced": "MAZZY_INCLUDE_ENHANCED_TIMING=1 vite build",
    "build:diagnostics": "MAZZY_INCLUDE_DIAGNOSTICS=1 vite build",
    "acceptance:party-app": "npm run build:diagnostics && node tools/runPartyAppJourneyBrowser.mjs",
    "preview:diagnostics": "MAZZY_INCLUDE_DIAGNOSTICS=1 vite preview",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:soak-sim": "vitest run src/diagnostics/simulateSoak.test.ts",
    "test:party-soak-sim": "vitest run src/diagnostics/simulateSoak.test.ts src/diagnostics/simulatePartyAutopilotSoak.test.ts src/diagnostics/deviceSoakReport.test.ts",
    "benchmark:rhythm": "vitest run src/diagnostics/rhythmBenchmark.test.ts --reporter=verbose",
    "benchmark:real-tracks": "node tools/realTrackAudit.mjs",
    "benchmark:beat-this": "node tools/beatThisPrototype.mjs",
    "prepare:beat-this-onnx": "node tools/prepareBeatThisOnnx.mjs",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "music-tempo": "^1.0.3",
    "onnxruntime-web": "^1.23.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "signalsmith-stretch": "1.3.2",
    "tone": "^15.1.22",
    "wavesurfer.js": "^7.12.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "essentia.js": "^0.1.3",
    "fake-indexeddb": "6.2.5",
    "typescript": "^7.0.2",
    "vite": "^7.1.7",
    "vitest": "^4.1.10"
  }
}
